# .env.local.example
# Copy this file to .env.local and fill in your Firebase credentials

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: For development with Firebase Emulator
# Set to true to use local Firebase Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Application Configuration
NEXT_PUBLIC_APP_NAME=H&I System
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LANGUAGE=es
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Demo Mode (set to true to enable demo data)
NEXT_PUBLIC_DEMO_MODE=false
